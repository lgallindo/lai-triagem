# Plain git only: no DVC, no git-lfs. Data is never committed.
data/
*.csv
*.zip
*.parquet

.venv/
__pycache__/
*.pyc

# Model binaries are regenerated by scripts/train.py in ~20s; the text model and
# JSON sidecar are small enough to commit, so they are NOT ignored here.
artifacts/train_log*.txt
bentoml/
.bentoml/

# Backup gerado por refresh_organ_tables.py --apply; nao versionar.
artifacts/*.bak
artifacts/*.json.bak
